data: {"candidates": [{"content": {"parts": [{"text": "Whiskers, a sleek black cat with eyes like polished"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 12,"totalTokenCount": 1301,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " emeralds, usually spent his evenings in a state of dignified repose. Curled on the armchair, he was a silent, furry sculpture, only occasionally twitching an ear at the distant wail of a siren or the creak of the old"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 62,"totalTokenCount": 1351,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " house settling.\n\nThen, a flicker.\n\nIt wasn't a mouse, or even a dust bunny on the run, but something far more intriguing: a large, pale moth, batting haphazardly against the lampshade, drawn to"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 110,"totalTokenCount": 1399,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " the light like a tiny, erratic ghost.\n\nOne emerald eye cracked open. A twitch of a whisker, so slight it might have been imagined, was Whiskers' only initial response. His tail tip, however, began a"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 158,"totalTokenCount": 1447,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " slow, almost imperceptible sway. The hunt was on.\n\nSlipping off the armchair like melting shadow, he flowed across the carpet. Each paw was placed with silent precision, his body low to the ground, a predatory grace in"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 206,"totalTokenCount": 1495,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " every movement. The moth, oblivious, continued its dizzying dance around the bulb.\n\nWhiskers coiled, a spring loaded. His muscles tensed, every fiber of his being focused on that fluttering target. He gathered himself, took"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 254,"totalTokenCount": 1543,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " a deep breath that barely disturbed his fur, and then... *pounced!*\n\nIt was a magnificent leap, a blur of black fur arcing towards the light. His front paws, claws sheathed but ready, swiped at the air"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 304,"totalTokenCount": 1593,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": ". The moth, startled by the sudden upheaval, zipped away just as Whiskers landed with a soft *thump* on the nearby bookshelf, sending a stack of paperbacks askew.\n\nHe blinked, a flicker of chagrined"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 353,"totalTokenCount": 1642,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " surprise in his eyes. The moth, having escaped, settled high on the wall, a tiny, triumphant silhouette.\n\nWhiskers looked from the moth, to the disheveled books, then back to the moth. He let out a tiny"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 403,"totalTokenCount": 1692,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": ", almost imperceptible huff. The game was over. The prey had escaped.\n\nWith a final, exasperated twitch of his ear, Whiskers jumped back down. He ambled back to his armchair, hopped up, and within"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 452,"totalTokenCount": 1741,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

data: {"candidates": [{"content": {"parts": [{"text": " moments, was curled back into a ball of sleek black fur, eyes closed. The thrill of the chase, he seemed to decide, was often better than the catch itself. And besides, there was always tomorrow night."}],"role": "model"},"finishReason": "STOP","index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 497,"totalTokenCount": 1786,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1280,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "XhjAas2MOavxvdIP_Z_QwA0"}

